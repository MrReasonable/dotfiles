#!/usr/bin/env python3
"""Runtime values for Claude Code's zsh completion (see claude-zsh-completion).

  claude-complete-values sessions | agents | background | mcp | plugins[:enabled|:disabled]

Prints `value<TAB>description` lines, most useful first. Reads Claude Code's own
files (fast enough to run on every Tab), except `background`, which asks
`claude agents --json`. Silent on anything missing or unreadable: completion
just offers less. Managed by chezmoi.
"""
import datetime as dt
import glob
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CLAUDE = os.path.join(HOME, ".claude")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def one_line(text, width=70):
    text = re.sub(r"\s+", " ", text).strip()
    return text[:width] + ("…" if len(text) > width else "")


def session_info(path):
    """(title, automated): a custom title or summary if the session has one,
    else its first prompt; automated if it was started through the SDK (e.g. the
    background security reviews), not by you in the terminal."""
    title = first = entry = None
    try:
        with open(path, errors="replace") as f:
            for i, line in enumerate(f):
                if i > 400:
                    break
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                kind = rec.get("type")
                entry = entry or rec.get("entrypoint")
                if kind == "custom-title" and rec.get("customTitle"):
                    title = rec["customTitle"]
                    break
                if kind == "summary" and rec.get("summary") and not title:
                    title = rec["summary"]
                if kind == "user" and first is None and not rec.get("isSidechain"):
                    content = (rec.get("message") or {}).get("content")
                    if isinstance(content, list):
                        content = " ".join(c.get("text", "") for c in content
                                           if isinstance(c, dict) and c.get("type") == "text")
                    if isinstance(content, str) and content.strip() and not content.lstrip().startswith("<"):
                        first = content
    except OSError:
        return "", False
    return title or first or "", str(entry or "").startswith("sdk")


def sessions():
    folder = re.sub(r"[/.]", "-", os.getcwd())
    files = sorted(glob.glob(os.path.join(CLAUDE, "projects", folder, "*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    shown = 0
    for path in files[:120]:
        title, automated = session_info(path)
        if automated:
            continue
        when = dt.datetime.fromtimestamp(os.path.getmtime(path)).strftime("%d %b %H:%M")
        yield os.path.basename(path)[:-6], f"{when}  {one_line(title)}"
        shown += 1
        if shown == 30:
            break


def frontmatter(path):
    try:
        with open(path, errors="replace") as f:
            head = f.read(4000)
    except OSError:
        return {}
    m = re.match(r"^---\n(.*?)\n---", head, re.S)
    return dict(re.findall(r"^(\w+):\s*(.*)$", m.group(1), re.M)) if m else {}


def enabled_plugins():
    """{name@marketplace: install path} for plugins that are enabled."""
    enabled = (load(os.path.join(CLAUDE, "settings.json")).get("enabledPlugins") or {})
    installed = load(os.path.join(CLAUDE, "plugins", "installed_plugins.json"))
    installed = installed.get("plugins", installed)
    out = {}
    for key, entries in installed.items():
        if enabled.get(key) and isinstance(entries, list) and entries:
            out[key] = entries[0].get("installPath", "")
    return out


def agents():
    for folder in (os.path.join(os.getcwd(), ".claude", "agents"), os.path.join(CLAUDE, "agents")):
        for path in sorted(glob.glob(os.path.join(folder, "*.md"))):
            fm = frontmatter(path)
            yield fm.get("name") or os.path.basename(path)[:-3], one_line(fm.get("description", ""))
    for key, root in sorted(enabled_plugins().items()):
        plugin = key.split("@")[0]
        for path in sorted(glob.glob(os.path.join(root, "agents", "*.md"))):
            fm = frontmatter(path)
            name = fm.get("name") or os.path.basename(path)[:-3]
            yield f"{plugin}:{name}", one_line(fm.get("description", ""))


def background():
    try:
        res = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True,
                             text=True, timeout=10, stdin=subprocess.DEVNULL)
        items = json.loads(res.stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return
    for s in items if isinstance(items, list) else []:
        where = (s.get("cwd") or "").replace(HOME, "~")
        if s.get("name"):
            yield s["name"], f"{s.get('status', '')}  {where}"
        if s.get("sessionId"):
            yield s["sessionId"][:8], f"{s.get('name', '')}  {s.get('status', '')}"


def mcp():
    config = load(os.path.join(HOME, ".claude.json"))
    seen = {}
    for name in (config.get("mcpServers") or {}):
        seen.setdefault(name, "user")
    for name in ((config.get("projects") or {}).get(os.getcwd(), {}).get("mcpServers") or {}):
        seen.setdefault(name, "this project (local)")
    for name in (load(".mcp.json").get("mcpServers") or {}):
        seen.setdefault(name, "this project (.mcp.json)")
    yield from seen.items()


def plugins(which=None):
    enabled = (load(os.path.join(CLAUDE, "settings.json")).get("enabledPlugins") or {})
    installed = load(os.path.join(CLAUDE, "plugins", "installed_plugins.json"))
    for key in sorted(installed.get("plugins", installed)):
        on = bool(enabled.get(key))
        if which == "enabled" and not on or which == "disabled" and on:
            continue
        yield key, "enabled" if on else "disabled"


def main():
    kind, _, arg = (sys.argv[1] if len(sys.argv) > 1 else "").partition(":")
    source = {"sessions": sessions, "agents": agents, "background": background,
              "mcp": mcp, "plugins": lambda: plugins(arg or None)}.get(kind)
    if not source:
        sys.exit(f"usage: {os.path.basename(sys.argv[0])} sessions|agents|background|mcp|plugins[:enabled|:disabled]")
    for value, desc in source():
        print(f"{value}\t{desc}".replace("\n", " "))


if __name__ == "__main__":
    main()
