#!/bin/sh
# pip3 → proto's pip shim, so `pip3` gets the same Python as `pip`: the
# global pin in ~/.proto/.prototools, or a project's own. proto's Python plugin
# only creates python/pip shims. Falls back to the system pip3 if proto's Python
# isn't installed (e.g. a fresh machine before `proto install`). Managed by chezmoi.
shim="$HOME/.proto/shims/pip"
[ -x "$shim" ] && exec "$shim" "$@"
exec /usr/bin/pip3 "$@"
