#!/bin/sh
# Installs the global proto toolchain after `chezmoi apply`. chezmoi re-runs
# this whenever its rendered content changes, i.e. when any config below does:
#   .prototools: {{ include "dot_proto/dot_prototools.tmpl" | sha256sum }}
{{- range (joinPath .chezmoi.sourceDir "dot_proto/tool-plugins/*.toml*" | glob) }}
#   {{ base . }}: {{ include . | sha256sum }}
{{- end }}
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# btop and navi publish no macOS binaries and git-absorb only x86_64 ones, so
# they come from Homebrew.
for formula in btop git-absorb navi; do
  brew list --formula "$formula" >/dev/null 2>&1 || brew install "$formula"
done
{{ end -}}

# proto itself, on every OS: the prebuilt binary from its GitHub release, at
# the `proto = ` pin in .prototools, checked against the release's .sha256.
# After this first copy, proto keeps itself at that pin (whichever copy you
# run). It used to come from Homebrew on macOS, which has no Intel bottle,
# so the iMac compiled LLVM and Rust from source just to build it
# (2026-10-18); and on Linux from the official installer (curl | bash),
# which takes the newest release, skipping the 7-day wait, and checks
# nothing. The checksum comes from the same release, so it catches a broken
# download, not a tampered release.
{{- $proto := include "dot_proto/dot_prototools.tmpl" | regexFind "(?m)^proto = \"[^\"]+\"" | trimPrefix "proto = " | trimAll "\"" }}
{{- if not $proto }}{{ fail "install-cli-tools: no `proto = \"...\"` pin in dot_proto/dot_prototools.tmpl" }}{{ end }}
if [ ! -x "$HOME/.proto/bin/proto" ]; then
  case "$(uname -s) $(uname -m)" in
    "Darwin x86_64") target=x86_64-apple-darwin ;;
    "Darwin arm64") target=aarch64-apple-darwin ;;
    "Linux x86_64" | "Linux aarch64" | "Linux arm64")
      arch=$(uname -m)
      [ "$arch" = arm64 ] && arch=aarch64
      # Same check as the official installer: musl builds for Alpine & co.
      libc=gnu
      ldd --version 2>&1 | grep -qi musl && libc=musl
      target=$arch-unknown-linux-$libc ;;
    *)
      echo "proto: no prebuilt release for $(uname -s) $(uname -m)" >&2
      exit 1 ;;
  esac
  url=https://github.com/moonrepo/proto/releases/download/v{{ $proto }}/proto_cli-$target.tar.xz
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/proto.tar.xz" "$url"
  curl -fsSL -o "$tmp/proto.tar.xz.sha256" "$url.sha256"
  # The .sha256 file reads "<hash> *<file name>".
  expected=$(cut -d' ' -f1 "$tmp/proto.tar.xz.sha256")
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$tmp/proto.tar.xz" | cut -d' ' -f1)
  else
    actual=$(shasum -a 256 "$tmp/proto.tar.xz" | cut -d' ' -f1)
  fi
  if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
    echo "proto: checksum mismatch for $url (expected '$expected', got '$actual')" >&2
    exit 1
  fi
  tar -xJf "$tmp/proto.tar.xz" -C "$tmp"
  mkdir -p "$HOME/.proto/bin"
  install -m 755 "$tmp/proto_cli-$target/proto" "$tmp/proto_cli-$target/proto-shim" "$HOME/.proto/bin/"
fi

# Install everything pinned in ~/.proto/.prototools that's missing.
export PATH="$HOME/.proto/bin:$HOME/.proto/shims:$PATH"
cd "$HOME/.proto" && proto install
# Rebuild shims/bins so plugin changes (e.g. renamed executables) take effect.
proto regen --bin

# Rust: make the proto-pinned toolchain rustup's default and give it
# rust-analyzer (used by Neovim), clippy and rustfmt. proto's rust plugin has
# no components setting, and `rustup component add` is a no-op when present.
rust_bin=$(proto bin rust 2>/dev/null | grep -o '/[^"]*/toolchains/[^/"]*/bin/cargo' | tail -1)
if [ -n "$rust_bin" ] && [ -x "$HOME/.cargo/bin/rustup" ]; then
  toolchain=$(basename "$(dirname "$(dirname "$rust_bin")")")
  "$HOME/.cargo/bin/rustup" default "$toolchain"
  "$HOME/.cargo/bin/rustup" component add --toolchain "$toolchain" rust-analyzer clippy rustfmt
fi
{{- if ne .chezmoi.os "darwin" }}

# `rm` in .zshrc sends files to the trash; macOS has /usr/bin/trash built in,
# elsewhere use trash-cli (as a uv tool, uv being proto-managed).
command -v trash-put >/dev/null 2>&1 || uv tool install trash-cli
{{- end }}
{{- if and (eq .chezmoi.os "linux") (ne .chezmoi.arch "amd64") }}

# jless and git-absorb publish no ARM Linux builds, so they aren't proto pins
# here: compile the same versions (.chezmoidata.toml) with cargo, into
# ~/.cargo/bin. jless always links X11's xcb libraries (clipboard support).
# A failed build only warns, so it can't stop `chezmoi apply` / update-all.
if command -v apt-get >/dev/null 2>&1; then
  missing=""
  for pkg in libxcb1-dev libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing="$missing $pkg"
  done
  if [ -n "$missing" ]; then
    # shellcheck disable=SC2086
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y $missing ||
      echo "warning: couldn't install$missing; jless may not build" >&2
  fi
fi
for spec in jless@{{ .pins.jless }} git-absorb@{{ .pins.git_absorb }}; do
  name=${spec%@*} version=${spec#*@}
  "$HOME/.cargo/bin/cargo" install --list | grep -q "^$name v$version:" && continue
  "$HOME/.cargo/bin/cargo" install --locked "$spec" ||
    echo "warning: couldn't build $spec with cargo" >&2
done
{{- end }}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") }}

# delta stopped publishing Intel macOS builds with 0.20, so it isn't a proto
# pin here: compile the same version (.chezmoidata.toml) with cargo, into
# ~/.cargo/bin (the crate is git-delta, the binary delta). Not Homebrew: it
# has no Intel bottles either, and would build its own Rust (and LLVM) first.
# A failed build only warns, so it can't stop `chezmoi apply` / update-all.
"$HOME/.cargo/bin/cargo" install --list | grep -q "^git-delta v{{ .pins.delta }}:" ||
  "$HOME/.cargo/bin/cargo" install --locked "git-delta@{{ .pins.delta }}" ||
  echo "warning: couldn't build git-delta@{{ .pins.delta }} with cargo" >&2
{{- end }}
