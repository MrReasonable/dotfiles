[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = {{ .github_username | quote }}
	useConfigOnly = true
  signingkey = {{ .gpg_signing_key | quote }}
	email = {{ .github_email | quote }}
[pull]
	ff = only
[merge]
	ff = only
	conflictStyle = zdiff3
[branch]
  autoSetupRebase = always
[init]
	defaultBranch = main
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore
  untrackedCache = true
  fsmonitor = false
	editor = vim
	# delta comes from mise, so apps that don't load the shell (IDEs, GUIs) may
	# not find it; fall back to plain less there.
	pager = "command -v delta >/dev/null 2>&1 && exec delta || exec less -FRX"
[interactive]
	diffFilter = "command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat"
[delta]
	# n/N jump between files in a diff; `delta --side-by-side` or
	# DELTA_FEATURES=+side-by-side for two columns.
	navigate = true
	line-numbers = true
[diff]
	colorMoved = default
	# Structural (syntax-aware) diffs on demand: `git difftool`, or the aliases
	# below; delta stays the everyday pager.
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[alias]
	dft = -c diff.external=difft diff
	dlog = -c diff.external=difft log -p --ext-diff
	dshow = -c diff.external=difft show --ext-diff
[apply]
	whitespaces = nowarn
[color]
	ui = auto
[push]
  autoSetupRemote = true
{{- if eq .chezmoi.os "darwin" }}
[alias]
	lb = latest-build
[gpg]
  format = openpgp
[commit]
  gpgSign = true
[tag]
  gpgSign = true
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
[credential "https://github.com"]
	helper = !$(brew --prefix gh)/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !$(brew --prefix gh)/bin/gh auth git-credential
{{- end }}
