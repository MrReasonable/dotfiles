# External repos, each at the commit pinned in .chezmoidata.toml [git_pins]
# (bumped weekly by .github/workflows/git-pins.yml to commits it first saw 7+
# days ago). A pin change changes the URL, so chezmoi downloads the new commit.

# Oh my tmux! (~/.tmux.conf is a symlink into it). exact = false: its plugins/
# folder holds the tmux plugins Oh my tmux installs.
[".tmux"]
  type = "archive"
  url = "https://github.com/gpakosz/.tmux/archive/{{ (index .git_pins "gpakosz/.tmux").commit }}.tar.gz"
  stripComponents = 1

# navi cheatsheets (community); navi reads the .cheat files under
# ~/.local/share/navi/cheats and ignores everything else.
[".local/share/navi/cheats/denisidoro__cheats"]
  type = "archive"
  url = "https://github.com/denisidoro/cheats/archive/{{ (index .git_pins "denisidoro/cheats").commit }}.tar.gz"
  exact = true
  stripComponents = 1
[".local/share/navi/cheats/papanito__cheats"]
  type = "archive"
  url = "https://github.com/papanito/cheats/archive/{{ (index .git_pins "papanito/cheats").commit }}.tar.gz"
  exact = true
  stripComponents = 1
# cheat/cheatsheets (cheat's format, not navi's): converted into navi
# cheatsheets by ~/.local/bin/navi-cheats-build, so kept outside navi's path.
[".local/share/navi/sources/cheat-cheatsheets"]
  type = "archive"
  url = "https://github.com/cheat/cheatsheets/archive/{{ (index .git_pins "cheat/cheatsheets").commit }}.tar.gz"
  exact = true
  stripComponents = 1
  exclude = [".github", ".github/**", "*.md", "LICENSE*", ".*"]
