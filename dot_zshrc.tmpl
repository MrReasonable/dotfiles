# fzf-tab draws the completion list, so zsh's own menu stays off.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview 'eza -1 --color=always $realpath'
# Completion cache: also where OMZP::composer caches `composer global config
# bin-dir`; without it that PHP call (~0.2s) re-runs in turbo on every startup.
# Delete $XDG_CACHE_HOME/zsh/zcompcache/composer if composer's bin-dir moves.
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:complete:*:options' sort false

export GPG_TTY=$TTY


