# Source a tool's generated shell init, re-generating it only when the tool's
# binary changes (upgrades move it), instead of forking the tool every startup.
_cached_init() {
  local bin=${commands[$1]} cache
  [[ -n $bin ]] || return 0
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-${(j:_:)${@//[^A-Za-z0-9-]/}}.zsh
  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p ${cache:h} && "$@" >| $cache
  fi
  source $cache
}

# carapace completes ~1000 CLIs, but its init claims every command it knows,
# including ones zsh already completes well (git, ssh, ...). Keep those and
# let carapace fill in only commands that had no completion. Runs in turbo
# after zsh-completions' compinit, and before fzf-tab, which then shows it.
_carapace_init() {
  local -A native=("${(@kv)_comps}")
  _cached_init carapace _carapace zsh
  local cmd
  for cmd in ${(k)native}; do _comps[$cmd]=$native[$cmd]; done
}

# @console-tools: zi installs fd/bat/eza/rg only when they're missing. A tool
# already on PATH from outside zi (e.g. Homebrew) is skipped; otherwise the
# annex prints its "Loading … consisting of" notice on every login, because it
# checks for the plugin dir on disk and ignores the recipe's if'' guard.
# eza's zi recipe only ships a linux-x86_64 binary, and the annex refuses the
# whole group if eza is absent elsewhere, so skip it there (use brew instead).
local -a _ct_skip
local _ct_tool _ct_cmd
for _ct_tool _ct_cmd in fd fd bat bat eza eza ripgrep rg; do
  if [[ -n ${commands[$_ct_cmd]} && ${commands[$_ct_cmd]} != ${ZI[PLUGINS_DIR]}/* ]] ||
     [[ $_ct_tool == eza && $OSTYPE/$CPUTYPE != linux*/x86_64 && -z ${commands[eza]} ]]; then
    _ct_skip+=( $_ct_tool )
  fi
done

