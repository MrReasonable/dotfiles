{{- if eq .chezmoi.os "darwin" -}}
# Kept first: it can prompt for a password, which must happen before the p10k
# instant prompt below takes over the terminal.
#
# Tmux child-pane guard: tmux preserves env (and gpg-agent socket) from the
# session-root shell, so child panes inherit the unlocked keychain + loaded
# GPG passphrases without re-prompting. Without this guard, every new tmux
# pane (e.g. one per Claude Code reviewer agent) re-runs `security
# unlock-keychain` and `security find-generic-password`, prompting for the
# macOS login password per pane.
if [[ -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]] && [[ -z "$TMUX" ]]; then
  # Tell pinentry-auto.sh to use pinentry-curses over SSH.
  export PINENTRY_USER_DATA="USE_TTY=1"
  # SSH doesn't auto-unlock the login keychain like GUI login does, so
  # gpg-load-passphrase.sh can't read the stored GPG passphrase until we
  # unlock it. Prompts for the macOS login password once per SSH session.
  if [[ -o interactive ]]; then
    security unlock-keychain "$HOME/Library/Keychains/login.keychain-db"
  fi
fi
{{ end -}}

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ "$TERM_PROGRAM" != "vscode" ]]; then

  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi
fi

# Keep PATH/FPATH free of duplicates: nested shells and tmux panes inherit an
# already-built PATH and then prepend to it again.
typeset -U path fpath

{{- if eq .chezmoi.os "darwin" }}
# Login shells already ran `brew shellenv` in ~/.zprofile, so skip the fork and
# just move brew back to the front (PATH order must beat ~/.orbstack/bin, which
# also ships kubectl/orb/orbctl). Non-login shells without it still eval it.
if [[ -n $HOMEBREW_PREFIX ]]; then
  path=($HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin $path)
  fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)
elif [[ -d /opt/homebrew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- end}}
# The following lines were added by compinstall
zstyle :compinstall filename '{{ .chezmoi.homeDir }}/.zshrc'
{{- if eq .chezmoi.os "darwin" }}
local brew_dir="$HOMEBREW_PREFIX"
{{- else if eq .chezmoi.os "linux" }}
test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# End of lines added by compinstall
if [[ ! -f $HOME/.zi/bin/zi.zsh ]]; then
  print -P "%F{33}▓▒░ %F{160}Installing (%F{33}z-shell/zi%F{160})…%f"
  command mkdir -p "$HOME/.zi" && command chmod go-rwX "$HOME/.zi"
  command git clone -q --depth=1 --branch "main" https://github.com/z-shell/zi "$HOME/.zi/bin" && \
    print -P "%F{33}▓▒░ %F{34}Installation successful.%f%b" || \
    print -P "%F{160}▓▒░ The clone has failed.%f%b"
fi
source "$HOME/.zi/bin/zi.zsh"
autoload -Uz _zi
(( ${+_comps} )) && _comps[zi]=_zi
# examples here -> https://wiki.zshell.dev/ecosystem/category/-annexes
# compinit runs once, from zsh-completions' atload (zicompinit; zicdreplay) in
# the turbo block below. Trust the cached dump (-C: no compaudit scan, no fpath
# rescan) unless it is over a day old; `zi compinit` forces a rebuild.
() { (( $# )) && ZI[COMPINIT_OPTS]=-C } ${ZI[ZCOMPDUMP_PATH]}(N.mh-24)

{{- if eq .chezmoi.os "darwin" }}
export PATH="${brew_dir}/opt/findutils/libexec/gnubin:$PATH"
export PATH="/usr/local/opt/findutils/libexec/gnubin:$PATH"
{{- end }}

if [[ ! -f $HOME/.local/bin/mise ]]; then
 curl https://mise.run | sh
fi
eval "$(~/.local/bin/mise activate zsh)"
type proto > /dev/null 2>&1 || eval "$(mise use aqua:moonrepo/proto && mise install)"
if (( $+commands[proto] )); then
  # `proto activate` prints static glue (hook functions); cache it per binary.
  _proto_glue=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/proto-activate.zsh
  if [[ ! -s $_proto_glue || $commands[proto] -nt $_proto_glue ]]; then
    mkdir -p ${_proto_glue:h} && proto activate zsh >| $_proto_glue
  fi
  # Source the glue minus its trailing immediate `proto_activate` call; that
  # first activation is deferred to turbo below.
  eval "${$(<$_proto_glue)%proto_activate}"
  # proto also re-activates before *every* prompt (~35ms each); chpwd already
  # covers cd, so drop the precmd hook.
  precmd_functions=(${precmd_functions:#proto_activate})
  unset _proto_glue
fi


