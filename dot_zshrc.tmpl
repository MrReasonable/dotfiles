# rm moves things to the trash (recoverable) rather than deleting them:
# macOS' /usr/bin/trash, or trash-cli's trash-put elsewhere. Neither accepts
# rm's flags, so they're dropped: directories need no -r, and -f only means
# "ignore missing paths". `command rm` (or \rm) still deletes for real, and
# scripts are unaffected. `function` syntax, because common-aliases (turbo)
# aliases rm='rm -i' and `rm()` would be alias-expanded if that ran first.
function rm {
  local trash_cmd
  if [[ -x /usr/bin/trash ]]; then trash_cmd=/usr/bin/trash
  elif (( $+commands[trash-put] )); then trash_cmd=trash-put
  else command rm "$@"; return; fi
  local -a paths
  local force=0 opts_done=0 arg
  for arg in "$@"; do
    if (( ! opts_done )) && [[ $arg == -?* ]]; then
      if [[ $arg == -- ]]; then opts_done=1
      elif [[ $arg == --force || ( $arg != --* && $arg == *f* ) ]]; then force=1
      fi
      continue
    fi
    # macOS' trash takes no `--`, so keep dash-named paths from reading as flags
    # by making them explicitly relative.
    [[ $arg == -* ]] && arg=./$arg
    if [[ -e $arg || -L $arg ]]; then paths+=("$arg")
    elif (( ! force )); then print -u2 "rm: ${arg#./}: No such file or directory"; return 1
    fi
  done
  if (( ! $#paths )); then
    (( force )) && return 0
    print -ru2 -- "usage: rm [-f] file ... (moves to the trash; \\rm really deletes)"
    return 64
  fi
  $trash_cmd "${paths[@]}"
}

# y: run yazi, then cd to wherever it was left when it quits.
y() {
  local tmp cwd
  tmp=$(mktemp -t yazi-cwd.XXXXXX)
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [[ -n $cwd && $cwd != $PWD ]] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

# Warn (never fail) when proto tools are behind their latest release. The
# global pins are exact on purpose, so upgrading means bumping them in chezmoi.
_proto_outdated_warn() {
  (( $+commands[proto] )) || return 0
  local json lines
  # Run from ~/.proto: from ~ itself proto reads only ~/.prototools and skips
  # the global ~/.proto/.prototools; from here it walks up and reads both.
  json=$(builtin cd ~/.proto && PROTO_LOG=off proto outdated --json 2>/dev/null) || return 0
  if (( $+commands[jq] )); then
    # Compare numerically rather than trusting is_latest, which is also false
    # when a registry's "latest" tag lags a newer installed release.
    lines=$(jq -r 'def v: split("-")[0] | split(".") | map(tonumber? // 0);
      to_entries[] | select((.value.latest_version | v) > (.value.current_version | v))
      | "  \(.key) \(.value.current_version) -> \(.value.latest_version)  (\(.value.config_source))"' <<<"$json")
  elif [[ $json == *'"is_latest": false'* ]]; then
    # No jq (e.g. a bare Linux box): fall back to proto's own table.
    lines=$(builtin cd ~/.proto && proto outdated 2>/dev/null)
  fi
  [[ -n $lines ]] || return 0
  print -P "%F{yellow}proto: newer versions available:%f"
  print -r -- "$lines"
  print -P "%F{yellow}Widen the range or bump the pin in ~/.local/share/chezmoi/dot_proto/dot_prototools.tmpl, then chezmoi apply.%f"
}

# Bring every range-pinned proto tool up to the newest release in its range,
# then warn about whatever is still behind (a new major, or an exact pin).
# Plain `proto install` keeps the newest *installed* match and `proto outdated
# --update` rewrites ranges to exact versions, so install each spec explicitly.
_proto_update() {
  (( $+commands[proto] )) || return 0
  if (( $+commands[jq] )); then
    (
      builtin cd ~/.proto || exit
      local tool spec
      PROTO_LOG=off proto outdated --json 2>/dev/null |
        jq -r 'to_entries[] | select(.value.config_version | test("^[0-9]+\\.[0-9]+\\.[0-9]+$") | not)
          | "\(.key)\t\(.value.config_version)"' |
        while IFS=$'\t' read -r tool spec; do
          proto install "$tool" "$spec" || print -P "%F{red}proto: failed to update $tool ($spec)%f"
        done
    )
  else
    print -P "%F{yellow}proto: jq not found; skipping in-range updates.%f"
  fi
  _proto_outdated_warn
}

