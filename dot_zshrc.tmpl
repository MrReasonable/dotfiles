# Utilize Turbo and initialize the completion system
{{- if eq .chezmoi.os "darwin" }}
{{- /* zi wait pack atload=+"zicompinit_fast; zicdreplay" for brew-completions */ -}}
{{- end }}

# @console-tools: zi installs fd/bat/eza/rg only when they're missing. A tool
# already on PATH from outside zi (e.g. Homebrew) is skipped; otherwise the
# annex prints its "Loading … consisting of" notice on every login, because it
# checks for the plugin dir on disk and ignores the recipe's if'' guard.
# eza's zi recipe only ships a linux-x86_64 binary, and the annex refuses the
# whole group if eza is absent elsewhere, so skip it there (use brew instead).
local -a _ct_skip
local _ct_tool _ct_cmd
for _ct_tool _ct_cmd in fd fd bat bat eza eza ripgrep rg; do
  if [[ -n ${commands[$_ct_cmd]} && ${commands[$_ct_cmd]} != ${ZI[PLUGINS_DIR]}/* ]] ||
     [[ $_ct_tool == eza && $OSTYPE/$CPUTYPE != linux*/x86_64 && -z ${commands[eza]} ]]; then
    _ct_skip+=( $_ct_tool )
  fi
done

# Only the annexes (needed to install recipes) and the prompt load before the
# first prompt; the rest loads in turbo right after it's drawn.
# Turbo order matters: zsh-completions runs compinit, fzf-tab must load after
# compinit but before autosuggestions/F-Sy-H wrap the completion widgets.
# zoxide: --no-cmd because its default `zi` command would shadow zi itself, so
# `z` jumps and `zz` picks interactively; init is cached at install/update.
zi light-mode for z-shell/z-a-meta-plugins \
  @annexes \
  @romkatv

zi wait lucid light-mode for \
  @fuzzy \
  skip"${_ct_skip[*]}" @console-tools \
  @ext-git \
  atpull'zi creinstall $PWD' pick'/dev/null' atload'zicompinit; zicdreplay' \
    zsh-users/zsh-completions \
  Aloxaf/fzf-tab \
  atload'!_zsh_autosuggest_start' \
    zsh-users/zsh-autosuggestions \
    z-shell/F-Sy-H \
  from'gh-r' as'program' pick'zoxide' \
  atclone'./zoxide init zsh --no-cmd >| init.zsh' atpull'%atclone' src'init.zsh' \
  atload"alias z=__zoxide_z zz=__zoxide_zi" \
    ajeetdsouza/zoxide \
  id-as'proto-activate' atload'(( $+functions[proto_activate] )) && proto_activate' \
    z-shell/null
unset _ct_skip _ct_tool _ct_cmd

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
if [[ "$TERM_PROGRAM" != "vscode" ]]; then
  [[ -r "${HOME}/.p10k.zsh" ]] && source "${HOME}/.p10k.zsh"
else
  PROMPT='%n@%m:%~%# '
fi


