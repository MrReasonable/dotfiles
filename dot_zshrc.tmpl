# "Did you know?" tips. Sources: ~/.config/zsh/tips.txt (hand-written, in
# chezmoi) plus ~/.cache/zsh/tips/*.txt, generated by ~/.local/bin/tips-build
# from tmux, Neovim, tldr, navi and git. A random source is picked first, then a
# random line, so tldr's ~1000 examples don't drown out the rest; the
# hand-written file counts double. `code` in backticks is highlighted.
# Printed here, above the p10k instant prompt (output after it makes p10k
# warn); $(<file) and $RANDOM are builtins, so this forks nothing.
# `tip` shows another; `tips [source]` browses them all in fzf.
_tip_sources() {
  reply=(${XDG_CONFIG_HOME:-$HOME/.config}/zsh/tips.txt(N) ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/tips/*.txt(N))
}
_tip_label() { [[ $1 == */tips.txt ]] && REPLY=setup || REPLY=${1:t:r} }
tip() {
  emulate -L zsh; setopt extended_glob
  local -a reply lines; _tip_sources
  (( $#reply )) || return 0
  [[ $reply[1] == */tips.txt ]] && reply=($reply[1] $reply)   # hand-written x2
  local f=${reply[RANDOM % $#reply + 1]} REPLY
  lines=(${(f)"$(<$f)"}); lines=(${lines:#(\#*|)})
  (( $#lines )) || return 0
  local t=${lines[RANDOM % $#lines + 1]}
  t=${t//(#b)\`([^\`]##)\`/$'\e[36m'${match[1]}$'\e[39m'}
  _tip_label $f
  print -r -- $'\e[33m💡 Did you know?\e[39m \e[2m['"$REPLY"$']\e[22m '"$t"
}
tips() {
  emulate -L zsh; setopt extended_glob
  local -a reply lines; local f REPLY; _tip_sources
  for f in $reply; do
    _tip_label $f
    [[ -z ${1-} || $REPLY == $1 ]] || continue
    lines=(${(f)"$(<$f)"}); print -rl -- "[$REPLY] "${^${lines:#(\#*|)}}
  done | if (( $+commands[fzf] )); then fzf --no-sort --prompt 'tips> '; else ${PAGER:-less}; fi
}
# Rebuild the generated tips in the background, at most daily (from turbo,
# below, so tips-build inherits the full PATH).
_tips_refresh() {
  local stamp=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/tips/.built
  [[ -x $HOME/.local/bin/tips-build ]] || return 0
  [[ -n $stamp(#qN.mh-24) ]] && return 0
  $HOME/.local/bin/tips-build &>/dev/null &!
}
[[ -o interactive && -t 1 ]] && tip

