# Global proto toolchain. Managed by chezmoi (dot_proto/dot_prototools.tmpl);
# edit here rather than with `proto pin --global` / `proto outdated --update`
# (the latter also rewrites ranges into exact versions).
#
# Tools whose downloads proto checksum-verifies use a major range ("~26"; for
# 0.x the minor is the major, "~0.12"); `update-all` installs the newest
# release inside each range. Tools without published checksums stay pinned
# exactly, so a new binary only arrives through a reviewed change here.
node = "~26"
npm = "~12"
pnpm = "~12"
uv = "~0.12"

# CLI tools from GitHub releases, via the TOML plugins in ./tool-plugins.
# atuin publishes checksums (verified by its plugin), so it gets a range; the
# rest publish none and stay exact. `update-all` warns when they're behind.
atuin = "~18"
# carapace, just, sesh and watchexec publish combined checksum files
# (verified), so ranges.
carapace = "~1"
just = "~1"
sesh = "~2"
watchexec = "~2"
delta = "0.19.2"
difftastic = "0.71.0"
dust = "1.2.6"
hyperfine = "1.20.0"
jless = "0.9.0"
sd = "1.1.0"
tailspin = "7.0.0"
tlrc = "1.13.1"
xh = "0.26.2"
yazi = "26.9.1"
{{- if ne .chezmoi.os "darwin" }}
# btop ships no macOS binaries, git-absorb only x86_64 ones; macOS gets both
# from Homebrew.
btop = "1.4.7"
git-absorb = "0.9.0"
{{- end }}

[plugins]
atuin = "file://./tool-plugins/atuin.toml"
carapace = "file://./tool-plugins/carapace.toml"
delta = "file://./tool-plugins/delta.toml"
difftastic = "file://./tool-plugins/difftastic.toml"
dust = "file://./tool-plugins/dust.toml"
hyperfine = "file://./tool-plugins/hyperfine.toml"
jless = "file://./tool-plugins/jless.toml"
just = "file://./tool-plugins/just.toml"
sd = "file://./tool-plugins/sd.toml"
sesh = "file://./tool-plugins/sesh.toml"
tailspin = "file://./tool-plugins/tailspin.toml"
tlrc = "file://./tool-plugins/tlrc.toml"
watchexec = "file://./tool-plugins/watchexec.toml"
yazi = "file://./tool-plugins/yazi.toml"
xh = "file://./tool-plugins/xh.toml"
{{- if ne .chezmoi.os "darwin" }}
btop = "file://./tool-plugins/btop.toml"
git-absorb = "file://./tool-plugins/git-absorb.toml"
{{- end }}
