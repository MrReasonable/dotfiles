# Global proto toolchain. Managed by chezmoi (dot_proto/dot_prototools.tmpl);
# `proto pin --global` edits the live copy, so re-add it with `chezmoi re-add`
# (or edit the template) afterwards.
node = "26.10.0"
npm = "12.1.0"
pnpm = "12.8.1"
uv = "0.12.21"

# CLI tools from GitHub releases, via the TOML plugins in ./tool-plugins.
# Pinned exactly: only atuin publishes checksums, so new versions arrive only
# when bumped here. `update-all` warns when any of these are behind.
atuin = "18.23.0"
delta = "0.19.2"
dust = "1.2.6"
hyperfine = "1.20.0"
sd = "1.1.0"
tlrc = "1.13.1"
yazi = "26.9.1"
{{- if ne .chezmoi.os "darwin" }}
# btop ships no macOS binaries; macOS gets it from Homebrew.
btop = "1.4.7"
{{- end }}

[plugins]
atuin = "file://./tool-plugins/atuin.toml"
delta = "file://./tool-plugins/delta.toml"
dust = "file://./tool-plugins/dust.toml"
hyperfine = "file://./tool-plugins/hyperfine.toml"
sd = "file://./tool-plugins/sd.toml"
tlrc = "file://./tool-plugins/tlrc.toml"
yazi = "file://./tool-plugins/yazi.toml"
{{- if ne .chezmoi.os "darwin" }}
btop = "file://./tool-plugins/btop.toml"
{{- end }}
