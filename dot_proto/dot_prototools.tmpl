# Global proto toolchain. Managed by chezmoi (dot_proto/dot_prototools.tmpl);
# edit here rather than with `proto pin --global` / `proto outdated --update`.
#
# Every version is pinned exactly. Renovate (renovate.json) bumps a pin only
# once that release is 7 days old, which is when most compromised releases
# have already been caught and pulled; patch/minor bumps merge by themselves,
# majors wait for review. The `# renovate:` line above each pin says where its
# releases come from. `chezmoi update` (update-all) then installs whatever the
# pins say. To bump something now, edit the version here and chezmoi apply.

# proto itself: runs this version whichever copy of proto you call.
# renovate: datasource=github-releases depName=moonrepo/proto
proto = "0.62.3"

# renovate: datasource=node-version depName=node
node = "26.10.0"
# renovate: datasource=npm depName=npm
npm = "12.2.0"
# renovate: datasource=npm depName=pnpm
pnpm = "12.9.1"
# renovate: datasource=github-releases depName=astral-sh/uv
uv = "0.12.23"
# Rust via rustup (proto puts the pinned toolchain's bin first on PATH);
# rust-analyzer, clippy and rustfmt are added by the install script.
# renovate: datasource=github-releases depName=rust-lang/rust
rust = "1.99.0"
# Go and Python: proto's built-in plugins (Python is python-build-standalone).
# Global versions; a project's own .prototools still wins inside it.
# renovate: datasource=golang-version depName=go
go = "1.27.1"
# renovate: datasource=python-version depName=python
python = "3.14.8"

# CLI tools from GitHub releases, via the TOML plugins in ./tool-plugins (some
# verify published checksums, the rest can't: see each plugin).
# renovate: datasource=github-releases depName=atuinsh/atuin
atuin = "18.23.0"
# renovate: datasource=github-releases depName=carapace-sh/carapace-bin
carapace = "1.8.0"
# renovate: datasource=github-releases depName=dandavison/delta
delta = "0.20.1"
# renovate: datasource=github-releases depName=Wilfred/difftastic
difftastic = "0.71.0"
# renovate: datasource=github-releases depName=direnv/direnv
direnv = "2.37.1"
# renovate: datasource=github-releases depName=bootandy/dust
dust = "1.2.6"
# renovate: datasource=github-releases depName=sharkdp/hyperfine
hyperfine = "1.21.0"
{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") }}
# jless has no ARM Linux build (compiled with cargo there); its version lives
# in .chezmoidata.toml, shared with that build.
jless = {{ .pins.jless | quote }}
{{- end }}
# renovate: datasource=github-releases depName=casey/just
just = "1.58.0"
# renovate: datasource=github-releases depName=mamba-org/micromamba-releases extractVersion=^(?<version>\d+\.\d+\.\d+)-0$
micromamba = "2.9.0"
# renovate: datasource=github-releases depName=chmln/sd
sd = "1.1.0"
# renovate: datasource=github-releases depName=joshmedeski/sesh
sesh = "2.32.0"
# renovate: datasource=github-releases depName=bensadeh/tailspin
tailspin = "7.0.0"
# renovate: datasource=github-releases depName=tldr-pages/tlrc
tlrc = "1.13.1"
# renovate: datasource=github-releases depName=watchexec/watchexec
watchexec = "2.7.4"
# renovate: datasource=github-releases depName=ducaale/xh
xh = "0.26.2"
# renovate: datasource=github-releases depName=sxyazi/yazi
yazi = "26.9.1"
{{- if ne .chezmoi.os "darwin" }}

# Linux only. macOS gets these from Homebrew (btop, navi: no macOS release
# builds); on Linux the alternative would be Homebrew (which sudo-installs into
# /home/linuxbrew) or old distro packages.
# renovate: datasource=github-releases depName=aristocratos/btop
btop = "1.4.7"
{{- if eq .chezmoi.arch "amd64" }}
# git-absorb has no ARM Linux build (compiled with cargo there); version in
# .chezmoidata.toml.
git-absorb = {{ .pins.git_absorb | quote }}
{{- end }}
# renovate: datasource=github-releases depName=jqlang/jq extractVersion=^jq-(?<version>.+)$
jq = "1.8.2"
# renovate: datasource=github-releases depName=denisidoro/navi
navi = "2.24.0"
# renovate: datasource=github-releases depName=jesseduffield/lazygit
lazygit = "0.66.0"
# renovate: datasource=github-releases depName=cli/cli
gh = "2.102.0"
# renovate: datasource=github-releases depName=neovim/neovim
neovim = "0.12.5"
# renovate: datasource=github-releases depName=so-fancy/diff-so-fancy
diff-so-fancy = "1.4.14"
{{- end }}

[plugins]
atuin = "file://./tool-plugins/atuin.toml"
carapace = "file://./tool-plugins/carapace.toml"
delta = "file://./tool-plugins/delta.toml"
direnv = "file://./tool-plugins/direnv.toml"
difftastic = "file://./tool-plugins/difftastic.toml"
dust = "file://./tool-plugins/dust.toml"
hyperfine = "file://./tool-plugins/hyperfine.toml"
jless = "file://./tool-plugins/jless.toml"
just = "file://./tool-plugins/just.toml"
micromamba = "file://./tool-plugins/micromamba.toml"
sd = "file://./tool-plugins/sd.toml"
sesh = "file://./tool-plugins/sesh.toml"
tailspin = "file://./tool-plugins/tailspin.toml"
tlrc = "file://./tool-plugins/tlrc.toml"
watchexec = "file://./tool-plugins/watchexec.toml"
yazi = "file://./tool-plugins/yazi.toml"
xh = "file://./tool-plugins/xh.toml"
{{- if ne .chezmoi.os "darwin" }}
btop = "file://./tool-plugins/btop.toml"
git-absorb = "file://./tool-plugins/git-absorb.toml"
jq = "file://./tool-plugins/jq.toml"
navi = "file://./tool-plugins/navi.toml"
lazygit = "file://./tool-plugins/lazygit.toml"
gh = "file://./tool-plugins/gh.toml"
neovim = "file://./tool-plugins/neovim.toml"
diff-so-fancy = "file://./tool-plugins/diff-so-fancy.toml"
{{- end }}
